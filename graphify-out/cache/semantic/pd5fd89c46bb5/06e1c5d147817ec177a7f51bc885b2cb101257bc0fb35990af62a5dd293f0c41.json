{"nodes": [{"id": "claude_claude_md", "label": "CLAUDE.md - Istruzioni per Claude", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_backlog_vs_storico", "label": "BACKLOG.md vs STORICO.md (potatura 13/08/2026)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il backlog tiene solo cio che e aperto e le trappole; lo storico e una riga per lavoro chiuso, da aprire solo per rispondere a 'l'avevamo gia fatto?'."}, {"id": "claude_regola_d_oro_push", "label": "Regola d'oro: proporre il push dopo ogni commit", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude non puo sapere quanti token restano: l'unico innesco affidabile e il commit. Prima del push si aggiornano BACKLOG/STORICO e si esportano i dati, altrimenti il codice arriva su GitHub senza la sua spiegazione."}, {"id": "claude_esporta_dati", "label": "esporta_dati.py (export leggibile per il push)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hub.db e escluso da git (binario, contiene l'hash della password): data/backup/hub_export.json e l'unica copia versionata di giochi, team, progetti e build. Le password non entrano di proposito."}, {"id": "claude_esporta_completo", "label": "esporta_dati.py --completo --uscita (backup con hash)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backup vero con gli hash delle password: va tenuto fuori da ogni repo e lo script rifiuta di scriverlo in una cartella versionata. Non c'entra con il push."}, {"id": "claude_hub_db", "label": "hub.db (escluso da git)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_branch_sviluppo", "label": "Branch sviluppo (zona test)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_branch_main", "label": "Branch main (ufficiale)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo roba verificata e solo quando Davide lo dice; mai push di iniziativa ne --force senza si esplicito. Allineato a sviluppo l'11/08/2026, la foto di giugno vive su archivio/main-giugno-2026."}, {"id": "claude_branch_archivio", "label": "Branch archivio/... (fotografie immutabili)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_tag_lavoro", "label": "Tag di fine blocco (lavoro-AAAA-MM-GG-*)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_regole_di_lavoro", "label": "Le regole di lavoro di Davide", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Niente modifiche fuori scope (i bachi si segnalano), niente nomi inventati, niente dati inventati, convenzioni rispettate, BACKLOG e PROJECT_CONTEXT aggiornati insieme al codice."}, {"id": "claude_non_inventare_dati", "label": "Non inventare dati (regola #3)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meglio una lacuna dichiarata di un valore plausibile e falso."}, {"id": "claude_regola_8", "label": "Regola #8: caso noto Incineroar -> Amoonguss", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ogni modifica ai calcolatori va provata su un caso noto (A=183, D=122, HP=221, danno 85-102) sulla regulation pokedex, perche Amoonguss non e nel roster di MA."}, {"id": "claude_sweep_new_function", "label": "Sweep new Function() su script e handler inline", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un SyntaxError in un attributo ha tenuto morto il Ripristina del roster, uno in uno script l'intero PC Builder per settimane."}, {"id": "claude_fallback_silenziosi", "label": "Diffidare dei fallback silenziosi", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Piu bachi non davano errore ma il numero sbagliato: Speed Tier su lista statica, /api/moves sul file di MA, nome inesistente che rispondeva Mega Venusaur."}, {"id": "claude_grafo_fotografia", "label": "Il grafo e una fotografia (graphify --update)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify-out non si aggiorna da solo: confrontare la data di graph.json con l'ultimo commit; --update ri-estrae solo i file cambiati via manifest.json. Obbligatorio prima del collaudo finale e dell'inventario del codice morto."}, {"id": "claude_scrittura_dati_sicura", "label": "Scrittura dati solo via salva_catalogo() / _save_abilities()", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E li che vive la copia di sicurezza automatica."}, {"id": "claude_chiavi_catalogo_immutabili", "label": "Le chiavi del catalogo non si rinominano", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le usano filtri delle regulation, motore degli effetti e team salvati nel DB; per il testo a schermo ci sono nome_it e nome_en."}, {"id": "claude_risoluzione_per_nome", "label": "Risoluzione per nome ambigua (indiceNomi)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caso storico Sheer Force (Forza Bruta / Forzabruta), fusi l'11/08. indiceNomi() a parita di nome tiene la voce con effect, ma e una rete non una cura: un doppione si fonde, non si aggira."}, {"id": "claude_legame_nome_en", "label": "Legame Pokemon-abilita via nome_en", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il catalogo cita le abilita col nome inglese e le chiavi sono italiane: cambiare un nome_en stacca un Pokemon dalla sua abilita senza errore (Mega Meganium / Mega Sol)."}, {"id": "claude_controlla_abilita", "label": "controlla_abilita.py", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_script_rieseguibili", "label": "Script rieseguibili con --dry-run e copia in data/archive", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uno script che modifica dati curati deve rifiutarsi di farlo alla cieca e lasciare una copia."}], "edges": [{"source": "claude_claude_md", "target": "backlog_backlog_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_backlog_vs_storico", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_regola_d_oro_push", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_regola_d_oro_push", "target": "claude_esporta_dati", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_regola_d_oro_push", "target": "claude_backlog_vs_storico", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_regola_d_oro_push", "target": "claude_branch_sviluppo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_regola_d_oro_push", "target": "claude_branch_main", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_regola_d_oro_push", "target": "claude_tag_lavoro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_branch_main", "target": "claude_branch_archivio", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "sou