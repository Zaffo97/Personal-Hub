{"nodes": [{"id": "templates_catalog_editor_indice", "label": "INDICE (indice-dati del catalogo)", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 108-111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Righe precalcolate lato server (chiave, nome, info, numero, extra) per tutti e quattro i DB. L'editor lo muta in memoria dopo un salvataggio invece di ricaricare la pagina."}, {"id": "templates_catalog_editor_rendi", "label": "rendi() \u2014 render tabella catalogo", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 124-158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_catalog_editor_stessacosa", "label": "stessaCosa() \u2014 chiave e nome coincidono a meno di case/spazi", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 118-122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_catalog_editor_chiave_sotto_nome", "label": "La chiave si mostra solo se dice qualcosa in piu' del nome", "file_type": "rationale", "source_file": "templates/catalog_editor.html", "source_location": "lines 143-149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sul catalogo Pokemon la chiave e' lo slug minuscolo (Abomasnow/abomasnow): ripeterlo su 1026 righe sarebbe rumore, quindi il confronto ignora maiuscole e spazi. La ricerca invece batte su nome tradotto, chiave e info, altrimenti da quando si legge 'Assorbimento' non si troverebbe piu' scrivendo 'Absorb'."}, {"id": "templates_catalog_editor_apri", "label": "apri() \u2014 carica una voce dal catalogo", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 167-180", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_catalog_editor_salvavoce", "label": "salvaVoce() \u2014 POST /pokemon/api/catalogo/<db>/salva", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 204-224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invia anche nome_originale, cosi' il server sa distinguere una rinomina da un inserimento nuovo; la riga tornata dal server rimpiazza quella locale in INDICE."}, {"id": "templates_catalog_editor_elimina", "label": "elimina() \u2014 POST /pokemon/api/catalogo/<db>/elimina", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 226-242", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il server risponde con usata_da: si elimina comunque, ma il messaggio elenca chi la usava ed e' colorato come errore."}, {"id": "templates_catalog_editor_nuovavoce", "label": "nuovaVoce() \u2014 modelli JSON vuoti per i 4 DB", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 182-194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gli scheletri (pokemon/moves/abilities/items) sono la documentazione de facto della forma di una voce di catalogo."}, {"id": "templates_catalog_editor_caricaarchivi", "label": "caricaArchivi() \u2014 elenco archivi catalogo", "file_type": "code", "source_file": "templates/catalog_editor.html", "source_location": "lines 244-271", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_editor_chiave_vs_nome_tradotto", "label": "Nome tradotto sopra, chiave del catalogo sotto", "file_type": "rationale", "source_file": "templates/catalog_editor.html", "source_location": "lines 143-149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Convenzione condivisa dai quattro editor: si mostra nomeVis() in grassetto e la chiave in monospace sotto, ma solo quando differisce; la ricerca batte su entrambe le lingue e sulla chiave. La chiave resta l'identita' della voce, quella che i team salvati e i filtri delle regulation usano."}], "edges": [{"source": "templates_catalog_editor_rendi", "target": "templates_catalog_editor_stessacosa", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "line 147", "weight": 1.0}, {"source": "templates_catalog_editor_rendi", "target": "templates_catalog_editor_indice", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "lines 129-131", "weight": 1.0}, {"source": "templates_catalog_editor_salvavoce", "target": "templates_catalog_editor_rendi", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "line 221", "weight": 1.0}, {"source": "templates_catalog_editor_salvavoce", "target": "templates_catalog_editor_indice", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "lines 218-219", "weight": 1.0}, {"source": "templates_catalog_editor_elimina", "target": "templates_catalog_editor_rendi", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "line 237", "weight": 1.0}, {"source": "templates_catalog_editor_apri", "target": "templates_catalog_editor_salvavoce", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/catalog_editor.html", "source_location": "lines 173, 213", "weight": 1.0}, {"source": "templates_catalog_editor_chiave_sotto_nome", "target": "templates_catalog_editor_rendi", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour