{"nodes": [{"id": "templates_fanta_consiglio", "label": "_fanta_consiglio.html", "file_type": "code", "source_file": "templates/_fanta_consiglio.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meta' del file e' la dichiarazione del criterio: la titolarita' non si sa (probabili non lette), e un consiglio che non lo dicesse sembrerebbe sapere cio' che non sa. Se cambia l'ordinamento in fanta.py, questo testo cambia con lui."}, {"id": "templates_fanta_consiglio_riga", "label": "riga() macro (riga undici consigliato)", "file_type": "code", "source_file": "templates/_fanta_consiglio.html", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_fanta_consiglio_criterio_undici", "label": "Criterio di scelta dell'undici (puo' giocare, poi fantamedia di lega)", "file_type": "rationale", "source_file": "templates/_fanta_consiglio.html", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1) va in fondo chi di sicuro non gioca (ceduti, squadra senza partita); 2) decide la fantamedia ricalcolata con le regole della lega; valore assente != zero; panchina con al massimo tanti per ruolo quanti ne schiera il modulo. L'avversario e' mostrato ma non pesa: un peso scelto sarebbe un numero inventato."}, {"id": "templates_fanta_consiglio_fantamedia_ricalcolata", "label": "Fantamedia ricalcolata con le regole della lega", "file_type": "concept", "source_file": "templates/_fanta_consiglio.html", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comprende gol, assist, ammonizioni, espulsioni, gol subiti, rigori parati/sbagliati, autogol; esclusa la porta inviolata che nessuna fonte riporta. Verificata: 408 su 414 coincidono con la fantamedia del file a valori standard."}, {"id": "templates_fanta_consiglio_modificatore_difesa", "label": "Modificatore di difesa (valore pieno, se giocano tutti)", "file_type": "concept", "source_file": "templates/_fanta_consiglio.html", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non e' moltiplicato per la probabilita' che giochino: quella probabilita' qui non c'e'."}], "edges": [{"source": "templates_fanta_consiglio", "target": "templates_fanta_stemma", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L8", "weight": 1.0}, {"source": "templates_fanta_consiglio_riga", "target": "templates_fanta_stemma_stemma", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L128", "weight": 1.0}, {"source": "templates_fanta_consiglio", "target": "blueprints_fantacalcio_chi_gioca", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L13", "weight": 1.0}, {"source": "templates_fanta_consiglio", "target": "blueprints_fantacalcio_formazione", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L99", "weight": 1.0}, {"source": "templates_fanta_consiglio", "target": "blueprints_fantacalcio_consiglio_applica", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L101", "weight": 1.0}, {"source": "templates_fanta_consiglio", "target": "fanta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/_fanta_consiglio.html", "source_location": "L6", "weight": 1.0}, {"source": "templates_fanta_consiglio", "target": "fanta_consiglia_moduli", "relation": "shares_data_with", "confidence"