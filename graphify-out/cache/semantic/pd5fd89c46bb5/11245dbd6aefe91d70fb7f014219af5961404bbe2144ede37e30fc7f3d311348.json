{"nodes": [{"id": "templates_uscite", "label": "uscite.html", "file_type": "code", "source_file": "templates/uscite.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_uscite_aggiorna_batch_loop", "label": "Aggiorna calendario batch loop (POST /gaming/uscite/aggiorna)", "file_type": "code", "source_file": "templates/uscite.html", "source_location": "L249", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server processes a chunk and returns the offset to resume from; client loops until finito so no single HTTP request hangs for minutes. Discarded rows (scarti) and excluded platforms (escluse, counted by name because PIATTAFORME_TENUTE fails closed) are reported on screen."}, {"id": "templates_uscite_svuota_cache", "label": "Svuota cache (POST /gaming/uscite/svuota)", "file_type": "code", "source_file": "templates/uscite.html", "source_location": "L319", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks for confirmation but archives nothing: the only table regenerable by pressing a button."}, {"id": "templates_uscite_igdb_credentials_env", "label": "IGDB credentials only in environment variables", "file_type": "rationale", "source_file": "templates/uscite.html", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IGDB (Twitch) covers all platforms whereas Steam only has Steam games. IGDB_CLIENT_ID / IGDB_CLIENT_SECRET live only in env vars: never in project files, git, or a text field on the page."}, {"id": "templates_uscite_declared_truncation", "label": "Truncated / filtered lists must declare it", "file_type": "rationale", "source_file": "templates/uscite.html", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a cap the page weighed 3.3 MB with 4224 images; a cut list that doesn't say so lies. The hype filter states how many releases it hides (hypes set on only 39% of rows), date precision other than 'giorno' is shown as IGDB's human form, and out-of-period search hits are linked."}], "edges": [{"source": "templates_gaming_filter_querystring_carry", "target": "templates_uscite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L76", "weight": 1.0}, {"source": "templates_uscite", "target": "templates_base", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L1", "weight": 1.0}, {"source": "templates_uscite", "target": "templates_gaming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L30", "weight": 1.0}, {"source": "templates_uscite", "target": "blueprints_gaming_uscite", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "templates/uscite.html", "source_location": "L144", "weight": 1.0}, {"source": "templates_uscite_igdb_credentials_env", "target": "templates_steam_import", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L48", "weight": 1.0}, {"source": "templates_uscite_aggiorna_batch_loop", "target": "templates_steam_import", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L241", "weight": 1.0}, {"source": "templates_uscite_igdb_credentials_env", "target": "templates_uscite", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/uscite.html", "source_location": "L47", "weight": 1.0}, {"source": "templates_uscite_declared_truncation", "target": "templates_uscit