{"nodes": [{"id": "templates_regulation_editor_page", "label": "Regulation Editor", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_showtoast", "label": "showToast", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_togglerawjson", "label": "toggleRawJson", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "251", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_getmechs", "label": "getMechs", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "256", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_removemech", "label": "removeMech", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "260", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_addmech", "label": "addMech", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "265", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_campifile", "label": "campiFile", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "281", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_savemeta", "label": "saveMeta", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "292", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_copiada", "label": "copiaDa", "file_type": "code", "source_file": "templates/regulation_editor.html", "source_location": "340", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_regulation_editor_regulation_come_filtro", "label": "Regulation come filtro sul catalogo", "file_type": "rationale", "source_file": "templates/regulation_editor.html", "source_location": "110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se reg.filter_file esiste la regulation e' solo un elenco di nomi sul catalogo unico: la UI nasconde i campi roster/moves/items e mostra i quattro link ai contenuti. I dati (base stat, potenza, effetti) restano nel catalogo, cosi' non esistono copie divergenti per regulation. Le regulation vecchie, non migrate, tengono ancora i tre file JSON e la UI si adatta."}, {"id": "templates_regulation_editor_salvataggio_parziale_campi", "label": "Salvataggio che non azzera i campi assenti", "file_type": "rationale", "source_file": "templates/regulation_editor.html", "source_location": "279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "campiFile() legge solo gli input effettivamente presenti nel DOM: sulle regulation a filtro roster/moves/items non esistono, e leggerli alla cieca scriverebbe stringhe vuote sopra i valori nel JSON. Inoltre saveMeta ricarica l'intera lista regulations e riscrive solo la voce corrente, per non perdere le altre."}, {"id": "templates_regulation_editor_meccaniche_non_tradotte", "label": "Meccaniche non tradotte", "file_type": "rationale", "source_file": "templates/regulation_editor.html", "source_location": "20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mega/tera/zmove/dynamax sono i valori salvati in `mechanics` dentro regulations.json e il team builder ci confronta sopra: tradurli romperebbe il confronto. Si traduce solo il testo che sta intorno."}, {"id": "templates_regulation_editor_ombra_di_t", "label": "Variabile di ciclo che ombra t()", "file_type": "rationale", "source_file": "templates/regulation_editor.html", "source_location": "214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nei cicli Jinja e nelle funzioni JS non si usa `t` come nome di variabile: ombrerebbe la funzione t() delle traduzioni per tutto il blocco. Qui il ciclo sui team usa `team`, in gaming.html `gioco`, in game_form.html `testo`/`etichetta`, in steam_import.html `titolo`."}], "edges": [{"source": "templates_regulation_editor_addmech", "target": "templates_regulation_editor_showtoast", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulation_editor.html", "source_location": "270", "weight": 1.0}, {"source": "templates_regulation_editor_addmech", "target": "templates_regulation_editor_removemech", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulation_editor.html", "source_location": "275", "weight": 1.0}, {"source": "templates_regulation_editor_savemeta", "target": "templates_regulation_editor_campifile", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulation_editor.html", "source_location": "294", "weight": 1.0}, {"source": "templates_regulation_editor_savemeta", "target": "templates_regulation_editor_getmechs", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulation_editor.html", "source_location": "295", "weight": 1.0}, {"source": "templates_regulation_editor_savemeta", "target": "templates_regulation_editor_showtoast", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulation_editor.html", "source_location": "297", "weight": 1.0}, {"source": "templates_regulation_editor_getmechs", "target