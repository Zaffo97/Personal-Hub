{"nodes": [{"id": "backlog", "label": "BACKLOG.md", "file_type": "document", "source_file": "BACKLOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contains only open items plus known traps; closed work moves to STORICO.md as one line (pruning of 13/08/2026)"}, {"id": "backlog_trappola_slug_mancante", "label": "Trap: entry without slug disappears from moveset", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "indice_catalogo() only takes entries with slug; three Gourgeist and Floette Fiore Eterno lost their moves 12/08-13/09 looking like invented forms"}, {"id": "backlog_moves_null_non_sappiamo", "label": "moves: null means 'unknown', not 'no moves'", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invented forms are not on PokeAPI; if null meant zero they would be unusable. Same logic for roster: null = whole catalog and puo_evolversi absent = unknown"}, {"id": "backlog_endpoint_fantasma", "label": "Trap: phantom endpoints swallowed by empty catch", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four times JS called responses never implemented (/api/regulations, d.moves, d.regulation, /api/team/<id>); an empty catch is a bug waiting"}, {"id": "backlog_scritture_concorrenti", "label": "Trap: concurrent writes to salva_catalogo without lock", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-file rewrite without lock: last save wins silently; relevant once online, hence single WSGI worker"}, {"id": "bac