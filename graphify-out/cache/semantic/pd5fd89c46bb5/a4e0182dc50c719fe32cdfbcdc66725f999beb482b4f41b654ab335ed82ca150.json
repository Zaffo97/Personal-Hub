": 0.85, "source_file": "PROJECT_CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "project_context_catalogo_unico", "target": "project_context_salva_catalogo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "247-249", "weight": 1.0}, {"source": "project_context_db_tabelle", "target": "project_context_init_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "446", "weight": 1.0}, {"source": "project_context_before_request_sezioni", "target": "project_context_login_required", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PROJECT_CONTEXT.md", "source_location": null, "weight": 1.0}, {"source": "project_context_extra_head", "target": "templates_base_extra_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "489", "weight": 1.0}, {"source": "project_context_t_jinja", "target": "templates_base_t", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "191-197", "weight": 1.0}, {"source": "project_context_t_jinja", "target": "templates_base_tf", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "191-197", "weight": 1.0}], "hyperedges": [{"id": "permessi_per_sezione", "label": "I permessi per sezione, dal before_request alle tre superfici che li mostrano", "nodes": ["project_context_before_request_sezioni", "templates_base_sidebar_sezioni_permesse", "templates_dashboard_riquadri", "templates_dashboard_pannelli", "templates_admin_utenti_page", "storico_utenti_permessi", "backlog_proprietario_dati", "backlog_editor_solo_admin"], "relation": "participate_in