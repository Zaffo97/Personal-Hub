{"nodes": [{"id": "project_context_create_app", "label": "create_app() e il context processor", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_regulation_default", "label": "regulation_default() \u2014 la prima regulation del registro", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il default del sito e' la prima voce di regulations.json, lo stesso criterio del fallback regs[0]: per cambiarlo si sposta una riga nel registro, non si tocca il codice. Sostituisce 14 letterali \"ma\"."}, {"id": "project_context_champions_bst", "label": "CHAMPIONS_BST \u2014 base stat grezze", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_init_db", "label": "init_db() \u2014 CREATE TABLE e ALTER TABLE con except: pass", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_login_required", "label": "login_required", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_nome_vis", "label": "nome_vis() \u2014 il nome da mostrare", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sceglie nome_it o nome_en con fallback sulla chiave: mai una stringa vuota."}, {"id": "project_context_traduzioni", "label": "traduzioni() e data/i18n/en.json", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dizionario italiano\u2192lingua con cache sull'mtime; per l'italiano e' {} perche' l'italiano e' la fonte."}, {"id": "project_context_t_jinja", "label": "t() e tf() lato Jinja", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tf() usa una sostituzione a mano e non str.format() perche' le frasi contengono graffe che non sono segnaposto (i blocchi effect mostrati negli editor)."}, {"id": "project_context_categorie", "label": "categorie() \u2014 chiave \u2192 etichetta tradotta", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una sola sorgente (mappa in data.py) per le tendine, i badge delle tabelle e la colonna Info del catalogo, dove prima erano tre elenchi scritti a mano."}, {"id": "project_context_cookie_lingua", "label": "hub_lang \u2014 la lingua in un cookie", "file_type": "rationale", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La lingua sta in un cookie e non in localStorage perche' la deve leggere anche Flask: roster, mosse e oggetti nelle tendine li renderizza il server."}, {"id": "project_context_salva_catalogo", "label": "salva_catalogo() e voci_catalogo()", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_save_abilities", "label": "_save_abilities() con copia pre-salvataggio", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_load_moveset", "label": "load_moveset() e mosse_legali()", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache sull'mtime del file: dopo un import il processo se ne accorge da se', senza riavvio."}, {"id": "project_context_pokemon_moves_json", "label": "data/catalog/pokemon_moves.json \u2014 main e champions", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sta fuori dal catalogo perche' pokemon.json finisce nel payload del browser; due elenchi per voce perche' non coincidono (Incineroar in Champions non ha Knock Off). Quale usare lo dice il campo moveset della regulation, non il codice."}, {"id": "project_context_stat_changes", "label": "stat_changes sulle mosse", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E' una proprieta' oggettiva della mossa, come il flag contact: si puo' aggiungere a una voce curata perche' non c'e' niente da decidere. Solo in aggiunta, mai in sovrascrittura."}, {"id": "project_context_indice_api", "label": "_INDICE e la risoluzione nomi/sprite di api_pokemon", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il catalogo tiene 84 forme annidate dentro forms di 72 Pokemon: senza _INDICE 96 nomi su 300 davano 404, quindi Mega e forme regionali non avevano ne' stat ne' sprite."}, {"id": "project_context_non_aliasabili", "label": "NON_ALIASABILI", "file_type": "rationale", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L'alias sul primo pezzo della chiave registrava mega, alolan, galarian... e faceva rispondere Mega Venusaur a un nome inesistente come Mega Machamp: la risposta giusta a un nome che non esiste e' 404, non un Pokemon a caso."}, {"id": "project_context_calcst", "label": "calcSt() \u2014 formula stat Champions", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unica implementazione, ma updateSpeed() usa la stessa formula inline: se si tocca una va allineata l'altra. Fino al 07/08/2026 erano disallineate (ev*2 contro floor(ev/4)), stesso Pokemon con numeri diversi nei due tab."}, {"id": "project_context_type_chart", "label": "TYPE_CHART \u2014 l'unica type chart", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non ricrearne una locale dentro calcDamage(): fino all'08/08/2026 la tabella mostrata all'utente era HTML scollegato, duplicato in due copie da 46 KB, che poteva divergere dal motore che documenta."}, {"id": "project_context_stage_mult", "label": "STAGE_MULT e stageMult()", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spostata in calcolatori-data.js perche' la usano sia il tab Danno sia lo Speed Tier, e due copie della stessa tabella sono cio' che qui e' gia' andato storto con TYPE_CHART."}, {"id": "project_context_catalogo_unico", "label": "Catalogo unico, regulation come filtro", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "data/catalog/ contiene tutto; le regulation sono soli elenchi di nomi (null = tutte). L'elenco di MA e' ereditato dai file storici e non e' verificato: non va usato come fonte di verita'."}, {"id": "project_context_moduli_calcolatori", "label": "I 7 moduli calcolatori-*.js e l'ordine obbligato", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sono classic script e non moduli: le funzioni restano globali e gli onclick del template le vedono; type=\"module\" romperebbe ogni handler inline. L'ordine data \u2192 core \u2192 danno \u2192 speed \u2192 stat \u2192 ui e' obbligatorio."}, {"id": "project_context_bootstrap_json", "label": "Il blocco calc-bootstrap \u2014 unico canale Flask\u2192JS", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_db_tabelle", "label": "Le tabelle SQLite di hub.db", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_before_request_sezioni", "label": "Permessi per sezione con un before_request su request.blueprint", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non decoratori per vista: le sezioni hanno decine di route ciascuna e bastava dimenticarne una per lasciare una porta aperta. Cosi' una route nuova nasce protetta, e la mappa blueprint\u2192sezione viene da SEZIONI in data.py perche' le due non possano divergere."}, {"id": "project_context_slug_overrides", "label": "SLUG_OVERRIDES per le forme speciali", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_context_extra_head", "label": "extra_head fuori dallo <style>", "file_type": "document", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prima stava dentro: il primo </style> di ogni figlio chiudeva lo stile di base, il CSS funzionava per caso e un <link> veniva ignorato come testo CSS."}], "edges": [{"source": "claude_regola_8", "target": "project_context_calcst", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "512-514", "weight": 1.0}, {"source": "claude_salva_catalogo_obbligatorio", "target": "project_context_salva_catalogo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "230-232", "weight": 1.0}, {"source": "claude_salva_catalogo_obbligatorio", "target": "project_context_save_abilities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "230-232", "weight": 1.0}, {"source": "backlog_moves_null", "target": "project_context_pokemon_moves_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "288-291", "weight": 1.0}, {"source": "project_context_create_app", "target": "project_context_init_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "119", "weight": 1.0}, {"source": "project_context_create_app", "target": "project_context_t_jinja", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_CONTEXT.md", "source_location": "180-182", "weight": 1.0}, {"source": "project_context_create_app", "target": "project_context_nome_vis", "relation": "references", "confidence": "EXTRACTED", "confiden