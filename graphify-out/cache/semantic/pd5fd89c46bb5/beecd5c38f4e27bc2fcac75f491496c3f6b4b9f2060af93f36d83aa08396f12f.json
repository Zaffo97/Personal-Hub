abel }}') interpola la label in una stringa JS ad apici singoli dentro un attributo a doppi: una label con un apostrofo romperebbe l'handler. Nessuna delle tre attuali ne ha uno, ma e' la stessa famiglia del baco del Ripristina del roster, e resta un rischio dichiarato."}], "edges": [{"source": "templates_regulations_list_page", "target": "templates_regulation_editor_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "54", "weight": 1.0}, {"source": "templates_regulations_list_createregulation", "target": "templates_regulation_editor_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "179", "weight": 1.0}, {"source": "templates_regulations_list_confirmdelete", "target": "templates_regulations_list_deleteregulation", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "141", "weight": 1.0}, {"source": "templates_regulations_list_confirmdelete", "target": "templates_regulations_list_label_in_handler_inline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "59", "weight": 1.0}, {"source": "templates_regulations_list_page", "target": "templates_regulations_list_eliminazione_bloccata_dai_team", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "55", "weight": 1.0}, {"source": "templates_regulations_list_createregulation", "target": "templates_regulation_editor_regulation_come_filtro", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/regulations_list.html", "source_location": "102", "weight": 1.0}, {"source": "templates_regu