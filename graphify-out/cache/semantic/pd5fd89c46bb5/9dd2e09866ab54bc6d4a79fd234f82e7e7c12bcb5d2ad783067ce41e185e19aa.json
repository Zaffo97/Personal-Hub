{"nodes": [{"id": "templates_moves_editor_movesdata", "label": "movesData \u2014 moves_ma.json nel textarea", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 199, 300, 362-364", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_moves_editor_rendertable", "label": "renderTable() \u2014 tabella mosse con flag e priorita'", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 202-282", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si cerca sia per chiave sia per nome tradotto; il nome tradotto va sopra e la CHIAVE sotto perche' e' l'identita' della voce e quella che si scrive nel JSON accanto."}, {"id": "templates_moves_editor_savedesc", "label": "saveDesc(el) \u2014 salva descrizione inline (mosse)", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 288-293", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qui riceve l'ELEMENTO e legge el.dataset.name, mentre startEditDesc riceve la stringa: e' la stessa coppia che in passato ha prodotto un TypeError perche' le due convenzioni erano invertite."}, {"id": "templates_moves_editor_deletemove", "label": "deleteMove(name)", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 296-299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si chiamava removeMove e leggeva el.dataset.name mentre il bottone passava il nome: eliminare una mossa non funzionava."}, {"id": "templates_moves_editor_syncjson", "label": "syncJson() \u2014 movesData -> textarea", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "line 300", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_moves_editor_fetchfrompokeapi", "label": "fetchFromPokeAPI() \u2014 auto-compila BP/tipo/categoria/desc", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 314-343", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chiama pokeapi.co dal browser, preferisce la flavor text italiana e ricade sull'inglese. L'avviso arancione resta apposta: i valori Champions possono differire da PokeAPI standard."}, {"id": "templates_moves_editor_addmove", "label": "addMove() \u2014 richiede la validazione PokeAPI", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 345-361", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_moves_editor_validazione_pokeapi", "label": "Nessuna mossa entra nel catalogo senza passare da PokeAPI", "file_type": "rationale", "source_file": "templates/moves_editor.html", "source_location": "lines 155, 337, 348-351", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "window._pokeapiValidated fa da lucchetto: viene azzerato a ogni battuta sul campo nome e alzato solo da un fetch riuscito, cosi' non si possono inventare BP e tipo a mano. E' la stessa regola del progetto sul non inventare dati."}, {"id": "templates_moves_editor_slug_tipo_non_ombra_t", "label": "La variabile di ciclo si chiama `tipo`, non `t`", "file_type": "rationale", "source_file": "templates/moves_editor.html", "source_location": "lines 98-106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`t` come variabile di ciclo Jinja ombrerebbe la funzione t() delle traduzioni per tutto il blocco. Le etichette restano gli slug inglesi di PokeAPI, che qui sono il valore del dato e non un'etichetta."}, {"id": "templates_moves_editor_type_clr", "label": "TYPE_CLR \u2014 colori tipo con chiavi slug inglesi", "file_type": "code", "source_file": "templates/moves_editor.html", "source_location": "lines 194-197", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copia locale della tavolozza dei tipi con le chiavi inglesi di moves_ma.json, mentre il calcolatore usa TYPE_CLR_IT con le chiavi italiane."}, {"id": "templates_moves_editor_tojson_apici_singoli", "label": "Attributo onsubmit ad apici singoli quando dentro c'e' |tojson", "file_type": "rationale", "source_file": "templates/moves_editor.html", "source_location": "lines 63-67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "|tojson rende il valore con le doppie: dentro un attributo delimitato da doppie l'attributo si chiuderebbe a meta'. Stessa trappola gia' pagata il 12/08 e ripresa dallo sweep."}], "edges": [{"source": "templates_moves_editor_movesdata", "target": "templates_calcolatori_tab_danno", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/moves_editor.html", "source_location": "lines 140-142", "weight": 1.0}, {"source": "templates_editor_chiave_vs_nome_tradotto", "target": "templates_moves_editor_rendertable", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/moves_editor.html", "source_location": "lines 264-269", "weight": 1.0}, {"source": "templates_moves_editor_savedesc", "target": "templates_moves_editor_syncjson", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/moves_editor.html", "source_location": "line 292", "weight": 1.0}, {"source": "templates_moves_editor_savedesc", "target": "templates_moves_editor_rendertable", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "templates/moves_editor.html", "source_location": "line 292", "weight": 1.0}, {"source": "templates_moves_editor_deletemove", "target": "templates_moves_editor_syncjson", "relation": "calls", "confidence": "EXTRACTED", "confidence