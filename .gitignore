# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Database locale — NON committare (vedi PROJECT_CONTEXT.md)
hub.db
# Le copie che `scripts/importa_dati.py` lascia prima di scrivere: stesso
# contenuto di hub.db, hash delle password compresi. Escluderne una e non
# l'altra sarebbe lo stesso buco con un altro nome.
*.db

# La chiave che firma i cookie di sessione. Generata al primo avvio, per la stessa
# ragione per cui hub.db non e' qui: chi la legge si firma un cookie da admin.
data/secret_key.txt

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# cache locale delle risposte PokeAPI (rigenerabile)
data/cache/

# I file allegati ai progetti di Stampa 3D: binari da decine di MB, uno per impronta.
# Non sono nell'export (che ne porta solo le righe): la cartella va copiata a mano.
data/stampa3d/

# Il backup `--completo` di scripts/esporta_dati.py: contiene gli hash delle
# password, come hub.db. Lo script si **rifiuta** gia' di scriverlo dentro una
# cartella versionata, e quella e' la rete vera; questa e' la seconda, per il
# giorno che il file ci finisce copiato a mano.
hub_completo*.json
*_completo.json
